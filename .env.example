# open-qr configuration. Copy to .env (start.sh / start.bat do this for you
# and generate a random POSTGRES_PASSWORD). Never commit your .env file.

# Database password. REQUIRED. Use a long random value, e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# The public base URL that gets encoded into every QR code.
# Set this to your real domain before printing codes, e.g. https://qr.example.com
PUBLIC_BASE_URL=http://localhost:8000

# Host port and interface the app is published on. 127.0.0.1 keeps it local
# (recommended behind a reverse proxy). Use 0.0.0.0 to expose it on your LAN.
APP_PORT=8000
BIND_ADDRESS=127.0.0.1

# Length of the random code in /r/{code} (5-32).
CODE_LENGTH=7

# Login session lifetime in hours.
SESSION_LIFETIME_HOURS=168

# Timezone used to group scans into days/weeks/months (IANA name).
STATS_TIMEZONE=UTC

# Privacy options. Raw user agents are NOT stored by default; only the
# device class (mobile/desktop/tablet/bot) and browser family are kept.
STORE_USER_AGENT=false
# Store only the referrer host (never the full URL). Set false to store nothing.
STORE_REFERRER=true

# Comma separated proxy IPs whose X-Forwarded-* headers are trusted.
# Inside Docker the reverse proxy usually connects from the bridge network.
FORWARDED_ALLOW_IPS=127.0.0.1

# Serve OpenAPI docs at /api/docs (off by default).
ENABLE_API_DOCS=false
